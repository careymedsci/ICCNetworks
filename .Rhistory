library(poweRlaw)
library(jsonlite)
args <- commandArgs(trailingOnly = TRUE)
input_csv <- args[1]
output_json <- args[2]
# -----------------------------
# 读取数据并展开为向量（k出现频次freq次）
# Read data and expand vector by frequency
data <- read.csv(input_csv)
#!/usr/bin/env Rscript
# 幂律分布分析（内置数据版本）
# 数据已硬编码在程序中，无需外部文件输入
library(poweRlaw)
library(jsonlite)
# -----------------------------
# 硬编码的原始数据
# -----------------------------
raw_data <- data.frame(
k = c(1, 2, 3, 4, 5, 6, 7, 8, 9),
freq = c(98, 98, 71, 44, 26, 17, 10, 7, 3)
)
# -----------------------------
# 数据验证
# -----------------------------
cat("正在验证数据...\n")
if (any(is.na(raw_data$k)) || any(is.na(raw_data$freq))) {
stop("错误：数据中包含NA值")
}
if (any(raw_data$k <= 0) || any(raw_data$freq <= 0)) {
stop("错误：度数和频次必须为正数")
}
cat("数据验证通过:\n")
print(raw_data)
# -----------------------------
# 展开数据为向量
# -----------------------------
data_vector <- as.numeric(rep(raw_data$k, raw_data$freq))
cat("\n总数据点数:", length(data_vector), "\n")
# -----------------------------
# 幂律分布拟合
# -----------------------------
cat("\n开始幂律拟合...\n")
m <- displ$new(data_vector)
est <- estimate_xmin(m)
xmin_initial <- est$xmin
alpha_initial <- est$pars
# 调整xmin确保至少有50个数据点
n_points_above_xmin <- sum(data_vector >= xmin_initial)
if (n_points_above_xmin < 50) {
unique_k <- sort(unique(data_vector))
xmin_adjusted <- NA
# 向下搜索合适的xmin
k_candidate <- xmin_initial
while (k_candidate >= min(unique_k) && is.na(xmin_adjusted)) {
if (sum(data_vector >= k_candidate) >= 50) {
xmin_adjusted <- k_candidate
}
k_candidate <- k_candidate - 1
}
# 向上搜索（如果向下搜索失败）
if (is.na(xmin_adjusted)) {
k_candidate <- xmin_initial + 1
while (k_candidate <= max(unique_k) && is.na(xmin_adjusted)) {
if (sum(data_vector >= k_candidate) >= 50) {
xmin_adjusted <- k_candidate
}
k_candidate <- k_candidate + 1
}
}
if (is.na(xmin_adjusted)) {
xmin_adjusted <- xmin_initial
warning("警告：未找到包含≥50个数据点的xmin，使用初始值")
}
m$setXmin(xmin_adjusted)
m$setPars(estimate_pars(m))
} else {
xmin_adjusted <- xmin_initial
}
# -----------------------------
# 统计检验
# -----------------------------
cat("\n执行KS检验（1000次模拟）...\n")
p1_result <- bootstrap_p(m, no_of_sims = 1000, threads = 15)
p1 <- p1_result$p
# 泊松分布比较
data_cut <- data_vector[data_vector >= xmin_adjusted]
lambda_pois <- mean(data_cut)
ll_pois <- sum(dpois(data_cut, lambda = lambda_pois, log = TRUE))
ll_pl <- dist_ll(m)
