#!/usr/bin/env Rscript
# 幂律分布分析（内置数据版本）
# 数据已硬编码在程序中，无需外部文件输入
library(poweRlaw)
library(jsonlite)
# -----------------------------
# 硬编码的原始数据
# -----------------------------
raw_data <- data.frame(
k = c(1, 2, 3, 4, 5, 6, 7, 8, 9),
freq = c(98, 98, 71, 44, 26, 17, 10, 7, 3)
)
# -----------------------------
# 数据验证
# -----------------------------
cat("正在验证数据...\n")
if (any(is.na(raw_data$k)) || any(is.na(raw_data$freq))) {
stop("错误：数据中包含NA值")
}
if (any(raw_data$k <= 0) || any(raw_data$freq <= 0)) {
stop("错误：度数和频次必须为正数")
}
cat("数据验证通过:\n")
print(raw_data)
# -----------------------------
# 展开数据为向量
# -----------------------------
data_vector <- as.numeric(rep(raw_data$k, raw_data$freq))
cat("\n总数据点数:", length(data_vector), "\n")
# -----------------------------
# 幂律分布拟合
# -----------------------------
cat("\n开始幂律拟合...\n")
m <- displ$new(data_vector)
m$setXmin(3)
est <- estimate_xmin(m)
xmin_initial <- est$xmin
alpha_initial <- est$pars
# 调整xmin确保至少有50个数据点
n_points_above_xmin <- sum(data_vector >= xmin_initial)
if (n_points_above_xmin < 50) {
unique_k <- sort(unique(data_vector))
xmin_adjusted <- NA
# 向下搜索合适的xmin
k_candidate <- xmin_initial
while (k_candidate >= min(unique_k) && is.na(xmin_adjusted)) {
if (sum(data_vector >= k_candidate) >= 50) {
xmin_adjusted <- k_candidate
}
k_candidate <- k_candidate - 1
}
# 向上搜索（如果向下搜索失败）
if (is.na(xmin_adjusted)) {
k_candidate <- xmin_initial + 1
while (k_candidate <= max(unique_k) && is.na(xmin_adjusted)) {
if (sum(data_vector >= k_candidate) >= 50) {
xmin_adjusted <- k_candidate
}
k_candidate <- k_candidate + 1
}
}
if (is.na(xmin_adjusted)) {
xmin_adjusted <- xmin_initial
warning("警告：未找到包含≥50个数据点的xmin，使用初始值")
}
m$setXmin(xmin_adjusted)
m$setPars(estimate_pars(m))
} else {
xmin_adjusted <- xmin_initial
}
# -----------------------------
# 统计检验
# -----------------------------
cat("\n执行KS检验（1000次模拟）...\n")
p1_result <- bootstrap_p(m, no_of_sims = 1000, threads = 15)
p1 <- p1_result$p
# 泊松分布比较
data_cut <- data_vector[data_vector >= xmin_adjusted]
lambda_pois <- mean(data_cut)
ll_pois <- sum(dpois(data_cut, lambda = lambda_pois, log = TRUE))
ll_pl <- dist_ll(m)
LR <- 2 * (ll_pl - ll_pois)
p_value_lr <- pchisq(LR, df = 1, lower.tail = FALSE)
# 截断幂律检验（如果数据足够）
if (sum(data_vector >= xmin_adjusted) >= 20) {
m_trunc <- disexp$new(data_vector)
m_trunc$setXmin(xmin_adjusted)
m_trunc$setPars(estimate_pars(m_trunc))
p1_trunc <- bootstrap_p(m_trunc, no_of_sims = 1000, threads = 15)$p
LR_trunc <- 2 * (dist_ll(m_trunc) - dist_ll(m))
p_value_lr_trunc <- pchisq(LR_trunc, df = 1, lower.tail = FALSE)
} else {
m_trunc <- NULL
p1_trunc <- NA
p_value_lr_trunc <- NA
}
# -----------------------------
# 输出结果
# -----------------------------
result <- list(
data_summary = list(
total_points = length(data_vector),
unique_degrees = length(unique(data_vector)),
min_degree = min(data_vector),
max_degree = max(data_vector)
),
powerlaw_fit = list(
xmin_initial = xmin_initial,
xmin_adjusted = xmin_adjusted,
alpha_initial = alpha_initial,
alpha_adjusted = m$pars,
p_value_ks = p1,
powerlaw_plausible = (p1 > 0.1)
),
comparison_tests = list(
poisson_lambda = lambda_pois,
p_value_vs_poisson = p_value_lr,
powerlaw_better = (p_value_lr < 0.025)
),
truncated_fit = if (!is.null(m_trunc)) list(
alpha = m_trunc$pars[1],
lambda = m_trunc$pars[2],
p_value_ks = p1_trunc,
p_value_vs_powerlaw = p_value_lr_trunc,
trunc_better = (p_value_lr_trunc < 0.05)
) else NULL
)
# 打印结果到屏幕
cat("\n分析结果:\n")
print(result)
# 保存到JSON文件（可选）
output_json <- "powerlaw_results.json"
write_json(result, output_json, auto_unbox = TRUE, pretty = TRUE)
cat("\n结果已保存至:", output_json, "\n")
#!/usr/bin/env Rscript
# 幂律分布分析（内置数据版本）
# 数据已硬编码在程序中，无需外部文件输入
library(poweRlaw)
library(jsonlite)
# -----------------------------
# 硬编码的原始数据
# -----------------------------
raw_data <- data.frame(
k = c(1, 2, 3, 4, 5, 6, 7, 8, 9),
freq = c(98, 98, 71, 44, 26, 17, 10, 7, 3)
)
# -----------------------------
# 数据验证
# -----------------------------
cat("正在验证数据...\n")
if (any(is.na(raw_data$k)) || any(is.na(raw_data$freq))) {
stop("错误：数据中包含NA值")
}
if (any(raw_data$k <= 0) || any(raw_data$freq <= 0)) {
stop("错误：度数和频次必须为正数")
}
cat("数据验证通过:\n")
print(raw_data)
# -----------------------------
# 展开数据为向量
# -----------------------------
data_vector <- as.numeric(rep(raw_data$k, raw_data$freq))
cat("\n总数据点数:", length(data_vector), "\n")
# -----------------------------
# 幂律分布拟合
# -----------------------------
cat("\n开始幂律拟合...\n")
m <- displ$new(data_vector)
m$setXmin(3)
est <- tryCatch(
estimate_xmin(m, xmins = unique(sort(data_vector))),
error = function(e) {
message("自动估计失败，改用保守xmin=3")
m$setXmin(3)
estimate_pars(m)
}
)
est <- estimate_xmin(m)
xmin_initial <- est$xmin
alpha_initial <- est$pars
# 调整xmin确保至少有50个数据点
n_points_above_xmin <- sum(data_vector >= xmin_initial)
if (n_points_above_xmin < 50) {
unique_k <- sort(unique(data_vector))
xmin_adjusted <- NA
# 向下搜索合适的xmin
k_candidate <- xmin_initial
while (k_candidate >= min(unique_k) && is.na(xmin_adjusted)) {
if (sum(data_vector >= k_candidate) >= 50) {
xmin_adjusted <- k_candidate
}
k_candidate <- k_candidate - 1
}
# 向上搜索（如果向下搜索失败）
if (is.na(xmin_adjusted)) {
k_candidate <- xmin_initial + 1
while (k_candidate <= max(unique_k) && is.na(xmin_adjusted)) {
if (sum(data_vector >= k_candidate) >= 50) {
xmin_adjusted <- k_candidate
}
k_candidate <- k_candidate + 1
}
}
if (is.na(xmin_adjusted)) {
xmin_adjusted <- xmin_initial
warning("警告：未找到包含≥50个数据点的xmin，使用初始值")
}
m$setXmin(xmin_adjusted)
m$setPars(estimate_pars(m))
} else {
xmin_adjusted <- xmin_initial
}
# -----------------------------
# 统计检验
# -----------------------------
cat("\n执行KS检验（1000次模拟）...\n")
p1_result <- bootstrap_p(m, no_of_sims = 1000, threads = 15)
p1 <- p1_result$p
# 泊松分布比较
data_cut <- data_vector[data_vector >= xmin_adjusted]
lambda_pois <- mean(data_cut)
ll_pois <- sum(dpois(data_cut, lambda = lambda_pois, log = TRUE))
ll_pl <- dist_ll(m)
LR <- 2 * (ll_pl - ll_pois)
p_value_lr <- pchisq(LR, df = 1, lower.tail = FALSE)
# 截断幂律检验（如果数据足够）
if (sum(data_vector >= xmin_adjusted) >= 20) {
m_trunc <- disexp$new(data_vector)
m_trunc$setXmin(xmin_adjusted)
m_trunc$setPars(estimate_pars(m_trunc))
p1_trunc <- bootstrap_p(m_trunc, no_of_sims = 1000, threads = 15)$p
LR_trunc <- 2 * (dist_ll(m_trunc) - dist_ll(m))
p_value_lr_trunc <- pchisq(LR_trunc, df = 1, lower.tail = FALSE)
} else {
m_trunc <- NULL
p1_trunc <- NA
p_value_lr_trunc <- NA
}
# -----------------------------
# 输出结果
# -----------------------------
result <- list(
data_summary = list(
total_points = length(data_vector),
unique_degrees = length(unique(data_vector)),
min_degree = min(data_vector),
max_degree = max(data_vector)
),
powerlaw_fit = list(
xmin_initial = xmin_initial,
xmin_adjusted = xmin_adjusted,
alpha_initial = alpha_initial,
alpha_adjusted = m$pars,
p_value_ks = p1,
powerlaw_plausible = (p1 > 0.1)
),
comparison_tests = list(
poisson_lambda = lambda_pois,
p_value_vs_poisson = p_value_lr,
powerlaw_better = (p_value_lr < 0.025)
),
truncated_fit = if (!is.null(m_trunc)) list(
alpha = m_trunc$pars[1],
lambda = m_trunc$pars[2],
p_value_ks = p1_trunc,
p_value_vs_powerlaw = p_value_lr_trunc,
trunc_better = (p_value_lr_trunc < 0.05)
) else NULL
)
# 打印结果到屏幕
cat("\n分析结果:\n")
print(result)
# 保存到JSON文件（可选）
output_json <- "powerlaw_results.json"
write_json(result, output_json, auto_unbox = TRUE, pretty = TRUE)
cat("\n结果已保存至:", output_json, "\n")
